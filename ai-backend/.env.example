# ─────────────────────────────────────────────────────────
# Priyanshu AI Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase — get from Dashboard → Settings → API
# Use the SERVICE_ROLE (secret) key — NOT the anon/publishable key
# The service_role key is a long JWT starting with "eyJ..."
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS — comma-separated list of allowed frontend origins
# Add your Vercel deployment URL when live
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio.vercel.app

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1024
# OPENAI_TEMPERATURE=0.7
# RATE_LIMIT=10/minute
